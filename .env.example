# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.

# --- LLM (scripts, step 1) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6          # cheaper than Opus; good for scripts

# --- Image generation (steps 5-6) — OpenAI GPT-Image ---
OPENAI_API_KEY=
IMAGE_GEN_MODEL=gpt-image-1          # verified API id; set to gpt-image-2 if your account has it (auto-falls back)
IMAGE_QUALITY=low                    # low|medium|high — low while iterating, high for keepers
IMAGE_SIZE=1536x1024                 # landscape; padded to 16:9 on white

# --- Voice / TTS (step 2) — ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_API_KEY=
TTS_VOICE_ID=

# --- Vid Rush (space pipeline video render) ---
VIDRUSH_API_KEY=
VIDRUSH_BASE_URL=

# --- YouTube Data API (upload, step 9) ---
YT_CLIENT_SECRETS=client_secret.json
YT_TOKEN_STORE=yt_token.json
YT_CHANNEL_ID=

# --- Research sources (space pipeline) ---
NASA_API_KEY=
